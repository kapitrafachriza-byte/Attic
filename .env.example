# ========================================================
# Attic Marketplace Environment Configuration
# ========================================================

# 1. DATABASE (PostgreSQL / Supabase / Neon)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/attic_db?schema=public"

# 2. NEXTAUTH / AUTHENTICATION
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="attic-super-secret-key-change-in-production-2026"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# 3. PAYMENT GATEWAY (Midtrans / Xendit Escrow)
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION=false

# 4. BULKY CARGO LOGISTICS (Lalamove / Deliveree API)
LALAMOVE_API_KEY="your-lalamove-api-key"
LALAMOVE_API_SECRET="your-lalamove-api-secret"
LALAMOVE_MARKET="ID"
LALAMOVE_ENV="sandbox"

# 5. OBJECT STORAGE (Cloudflare R2 / AWS S3 for Furniture Media)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="attic-furniture-media"
R2_PUBLIC_DOMAIN="https://media.atticmarketplace.com"

# 6. TRANSACTIONAL NOTIFICATIONS (Resend Email & WhatsApp Fonnte)
RESEND_API_KEY="your-resend-api-key"
FONNTE_WHATSAPP_TOKEN="your-fonnte-wa-token"
